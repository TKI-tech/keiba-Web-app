# このファイルを .env にコピーして値を埋める。.env はコミットしないこと(.gitignore済み)。

# Stripeダッシュボード > 開発者 > APIキー のテストモード用シークレットキー
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY

# Stripeダッシュボード > 商品 で作成したサブスクリプション用PriceのID
STRIPE_PRICE_ID=REPLACE_WITH_YOUR_STRIPE_PRICE_ID

# Stripe CLI (stripe listen --forward-to localhost:8080/webhook/stripe) 実行時に
# 表示される値、または本番Webhookエンドポイント作成時に発行される値
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# CheckoutからのリダイレクトURLの基点。Caddy経由でアクセスするURLを指定する
# (ローカルはCaddyfileの :8080 に合わせる。本番はデプロイ先のドメイン)
APP_BASE_URL=http://localhost:8080

# Stripe Webhook受信サーバー(webhook_server.py)が listen するポート
WEBHOOK_PORT=8502

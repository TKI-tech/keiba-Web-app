# このファイルを .env にコピーして値を埋める。.env はコミットしないこと(.gitignore済み)。

# Stripeダッシュボード > 開発者 > APIキー のテストモード用シークレットキー
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY

# Stripeダッシュボード > 商品 で作成したサブスクリプション用PriceのID
STRIPE_PRICE_ID=REPLACE_WITH_YOUR_STRIPE_PRICE_ID

# Stripe CLI (stripe listen --forward-to localhost:8080/webhook/stripe) 実行時に
# 表示される値、または本番Webhookエンドポイント作成時に発行される値
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# CheckoutからのリダイレクトURLの基点。Caddy経由でアクセスするURLを指定する
# (ローカルはCaddyfileの :8080 に合わせる。本番はデプロイ先のドメイン)
APP_BASE_URL=http://localhost:8080

# Stripe Webhook受信サーバー(webhook_server.py)が listen するポート
WEBHOOK_PORT=8502

# 確認メール・パスワード再設定メール送信用のResend設定。未設定でもアプリは動作するが、
# 該当のメール送信だけ失敗する(エラーメッセージが出るのみ)。
# https://resend.com で無料アカウントを作成し、APIキーを発行する(月3,000通/日100通まで無料)。
# RESEND_FROM_EMAILは省略可(未設定時は onboarding@resend.dev が使われる。独自ドメインの
# 送信元を使いたい場合はResend側でドメイン認証してから設定する)。
# 以前はSMTP(Gmail等)を使う実装だったが、Render等ではSMTPの送信ポートがネットワーク
# レベルでブロックされていることが多く、HTTPS経由のResend APIに切り替えている。
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev

# テスト用マスターアカウント(任意)。設定すると、この email/password で
# Stripe決済なしに常時「会員限定画面」を確認できるアカウントが自動的に用意される。
# 未設定なら何も起きない(デフォルトでは作成されない)。
# 本番公開する場合は、他人に推測されない強いパスワードを使うこと。
# 使い終わったら値を削除して無効化してもよい(既存アカウントのパスワードとしては残る)。
MASTER_EMAIL=REPLACE_WITH_YOUR_TEST_ADMIN_EMAIL
MASTER_PASSWORD=REPLACE_WITH_A_STRONG_TEST_PASSWORD
